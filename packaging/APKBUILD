# Contributor: AMINE EL HARRAK <amine.elharrak@gmail.com>
pkgname=orbisys
pkgver=1.0.0
pkgrel=0
pkgdesc="Linux system maintenance and administration application"
url="https://github.com/aelharrak/orbisys"
arch="x86_64 aarch64"
license="MIT AND ISC"
makedepends="cargo rust"
depends="polkit"
source="$pkgname-$pkgver-vendor.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-vendor.tar.gz"
sha512sums='f511ccc93cb29010321044fa9633ed00f2b18ebb8a6caf05af2c7118573fe5833c2ea293cc9659623efced4f3bb54ecd2dcdcdeddb35d6c1fd6cb5aa07f3bd89'
builddir="$srcdir/$pkgname-$pkgver"

build() {
	cd "$builddir"
	cargo build --release --offline
}

package() {
	cd "$builddir"
	install -Dm0755 target/release/orbisys "$pkgdir/usr/bin/orbisys"
	install -Dm0644 packaging/orbisys.desktop "$pkgdir/usr/share/applications/orbisys.desktop"
	install -Dm0644 packaging/orbisys.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/orbisys.svg"
	install -Dm0644 assets/icons/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.icons"
}
